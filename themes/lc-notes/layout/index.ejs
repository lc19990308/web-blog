<%
  const posts = page.posts ? page.posts.toArray() : [];
  const feature = posts[0];
  const remainingPosts = posts.slice(1);
  const summary = (post) => {
    const raw = post.description || post.excerpt || post.content || '';
    return raw.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 155);
  };
  const categoryName = (post) => {
    const categories = post.categories && post.categories.length ? post.categories.toArray() : [];
    return categories[0] ? categories[0].name : '笔记';
  };
  const data = site.data || {};
  const githubWeekly = data.github_weekly || data['github-weekly'] || {};
  const weeklyRepositories = Array.isArray(githubWeekly.repositories) ? githubWeekly.repositories.slice(0, 10) : [];
  const hasWeeklyRanking = weeklyRepositories.length === 10;
  const formatStars = (value) => new Intl.NumberFormat('zh-CN').format(Number(value) || 0);
  const formatGeneratedAt = (value) => {
    const timestamp = new Date(value);
    if (Number.isNaN(timestamp.getTime())) return '';
    return new Intl.DateTimeFormat('zh-CN', {
      timeZone: 'Asia/Shanghai',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false
    }).format(timestamp).replace(/\//g, '-');
  };
  const weeklyPeriod = githubWeekly.period || {};
  const weeklyGeneratedAt = formatGeneratedAt(githubWeekly.generatedAt);
%>
<main id="top">
  <section class="shell hero" aria-labelledby="site-title">
    <div class="hero-copy">
      <div class="annotation" aria-hidden="true"></div>
      <h1 id="site-title">前端技术<em>笔记</em></h1>
      <p>把前端工程、AI Agent 与真实项目里的判断写成可复用的研究记录。</p>
    </div>
    <aside class="hero-rail" aria-label="研究方向">
      <p>RESEARCH INDEX<br />持续更新 / <%= new Date().getFullYear() %></p>
      <div class="topic-list">
        <a href="<%= url_for('categories/#topic-language') %>">语言与类型 <b>01</b></a>
        <a href="<%= url_for('categories/#topic-interface') %>">界面与框架 <b>02</b></a>
        <a href="<%= url_for('categories/#topic-engineering') %>">工程与架构 <b>03</b></a>
        <a href="<%= url_for('categories/#topic-platform') %>">浏览器与性能 <b>04</b></a>
        <a href="<%= url_for('categories/#topic-exploration') %>">AI 与创作实验 <b>05</b></a>
      </div>
    </aside>
  </section>

  <% if (hasWeeklyRanking) { %>
    <section class="shell github-weekly" aria-labelledby="github-weekly-title">
      <div class="github-weekly__heading">
        <div>
          <p class="section-label">GITHUB WEEKLY INDEX</p>
          <h2 id="github-weekly-title">近 7 日新建高星项目</h2>
        </div>
        <div class="github-weekly__meta">
          <p>观察区间 <time datetime="<%= weeklyPeriod.start %>"><%= weeklyPeriod.start %></time> 至 <time datetime="<%= weeklyPeriod.end %>"><%= weeklyPeriod.end %></time></p>
          <p>
            <% if (weeklyGeneratedAt) { %>上次成功同步 <time datetime="<%= githubWeekly.generatedAt %>"><%= weeklyGeneratedAt %></time><% } %>
            <% if (githubWeekly.sourceUrl) { %><% if (weeklyGeneratedAt) { %><span aria-hidden="true"> / </span><% } %><a href="<%= githubWeekly.sourceUrl %>" target="_blank" rel="noopener noreferrer">数据来源</a><% } %>
          </p>
        </div>
      </div>
      <ol class="github-weekly__list" aria-label="近 7 日新建高星项目排行榜">
        <% weeklyRepositories.forEach((repository, index) => { %>
          <li class="github-weekly__item">
            <span class="github-weekly__rank" aria-label="第 <%= repository.rank || index + 1 %> 名"><%= String(repository.rank || index + 1).padStart(2, '0') %></span>
            <div class="github-weekly__repository">
              <h3><a href="<%= repository.url %>" target="_blank" rel="noopener noreferrer"><%= repository.fullName %></a></h3>
              <p><%= repository.description %></p>
            </div>
            <dl class="github-weekly__facts">
              <div><dt>Stars</dt><dd><%= formatStars(repository.stars) %></dd></div>
              <div><dt>语言</dt><dd><%= repository.language || '未标注' %></dd></div>
            </dl>
          </li>
        <% }) %>
      </ol>
    </section>
  <% } %>

  <% if (feature) { %>
    <article class="shell feature" aria-labelledby="feature-title">
      <div>
        <p class="section-label">LATEST FIELD NOTE</p>
        <h2 id="feature-title"><a href="<%= url_for(feature.path) %>"><%= feature.title %></a></h2>
        <div class="metadata"><span><%= date(feature.date, 'YYYY-MM-DD') %></span><span><%= categoryName(feature) %></span><span><%= Math.max(4, Math.ceil((feature.length || 1200) / 450)) %> 分钟阅读</span></div>
        <p class="feature-copy"><%= summary(feature) %></p>
        <a class="text-link" href="<%= url_for(feature.path) %>">阅读研究笔记</a>
      </div>
      <%- partial('_partials/research-map') %>
    </article>
  <% } %>

  <section class="shell latest" id="latest" aria-labelledby="latest-title">
    <div class="latest-heading">
      <p class="section-label">ALL NOTES</p>
      <h2 id="latest-title">按问题，而不是按热度写。</h2>
      <p>每一篇都从一个真实工程选择、失败记录或可验证的技术问题开始。</p>
    </div>
    <div class="entry-list">
      <% remainingPosts.forEach((post) => { %>
        <a class="entry" href="<%= url_for(post.path) %>">
          <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
          <h3><%= post.title %></h3>
          <span class="entry-category"><%= categoryName(post) %></span>
        </a>
      <% }) %>
      <% if (page.total > 1) { %>
        <nav class="pagination" aria-label="分页"><%- paginator({ prev_text: '上一页', next_text: '下一页' }) %></nav>
      <% } %>
    </div>
  </section>
</main>
