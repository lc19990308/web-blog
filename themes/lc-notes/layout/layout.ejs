<!doctype html>
<html lang="<%= config.language || 'zh-CN' %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="<%= page.description || config.description || config.title %>" />
    <title><%= page.title ? page.title + ' | ' + config.title : config.title %></title>
    <link rel="alternate" href="<%= url_for('atom.xml') %>" title="<%= config.title %>" type="application/atom+xml" />
    <link rel="stylesheet" href="<%= url_for('css/main.css') %>" />
  </head>
  <body>
    <header class="site-header shell">
      <a class="wordmark" href="<%= url_for('/') %>" aria-label="<%= config.title %> 首页">LC <span>/</span> NOTES</a>
      <nav class="main-nav" id="main-nav" aria-label="主导航">
        <a href="<%= url_for('/') %>"<% if (is_home()) { %> aria-current="page"<% } %>>笔记</a>
        <a href="<%= url_for('categories/') %>">专题</a>
        <a href="<%= url_for('about/') %>">关于</a>
        <a href="<%= url_for('archives/') %>">归档</a>
      </nav>
      <div class="header-actions">
        <button class="menu-button" aria-controls="main-nav" aria-expanded="false" aria-label="打开菜单" type="button">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        </button>
        <button class="search-button" aria-controls="search-dialog" aria-label="搜索文章" type="button">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg>
        </button>
      </div>
    </header>

    <%- body %>

    <footer class="shell footer">
      <span><%= theme.footer.since %> - <%= new Date().getFullYear() %> &copy; <%= config.author || config.title %></span>
      <span><%= theme.footer.statement %></span>
      <a href="<%= url_for('atom.xml') %>">RSS</a>
    </footer>

    <dialog class="search-dialog" id="search-dialog" data-search-url="<%= url_for('search.xml') %>">
      <div class="search-dialog__bar">
        <label for="site-search">搜索笔记</label>
        <button class="dialog-close" aria-label="关闭搜索" type="button">关闭</button>
      </div>
      <input id="site-search" type="search" autocomplete="off" placeholder="输入文章标题、主题或关键词" />
      <div class="search-results" aria-live="polite"></div>
    </dialog>

    <script src="<%= url_for('js/site.js') %>"></script>
  </body>
</html>
